@page "/teste"

<Titulo Texto="Este é o meu título"></Titulo>

<div>
    <label class="text-muted">Digite seu nome:</label>
    <input class="form-control" @bind-value=xpto>
</div>

<div class="mt-3">
    <button @onclick="Mudar" class="btn btn-outline-primary">Enviar</button>
</div>

<div class="row border mt-3">
    <div class="col bg-primary">
        Coluna 1
    </div>
    <div class="col bg-success">
        Coluna 2
    </div>
    <div class="col bg-warning">
        Coluna 3
    </div>
</div>

<div class="mt-3 rounded p-d shadow">
    <h1>Este é um texto em tamanho H1</h1>
</div>

@code 
{
    string xpto = "Andre Campos";

void Mudar()
    {
        xpto = "Componente Exemplo";
    }


}